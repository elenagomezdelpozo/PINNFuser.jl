param_symbols = [
    p_lookup["ParaLHeart₊CVmi"],   
    p_lookup["ParaLHeart₊CVao"],   
    p_lookup["ParaSys₊Rscp"],     
    p_lookup["ParaSys₊Rsvn"],     
    p_lookup["ParaSys₊Csvn"],     
    p_lookup["ParaSys₊Csat"],     
    p_lookup["ParaLHeart₊ElvMax"], 
    p_lookup["ParaLHeart₊ElvMin"], 
    p_lookup["ParaLHeart₊ElaMax"], 
