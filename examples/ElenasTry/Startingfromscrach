using DifferentialEquations, Lux, Optimization, OptimizationOptimJL, OptimizationOptimisers, ComponentArrays, SciMLSensitivity
using OrdinaryDiffEq, Zygote, StableRNGs, Plots
import Main.elenasimpleModel: ShiElastance, DShiElastance, Valve


# --- 1. Load & Prepare Data ---
tspan = (0.0, 11.0)
num_of_samples = 150 * 1 # 1 cardiac cycle for training
tsteps = range(9.0, 10.0, length = num_of_samples)

extrapolation_tspan = (0.0, 20.0)

loaded_data = readdlm("/Applications/Desktop/CODE/Thesis/PINNFuser.jl/examples/OneChamberModelCVS/original_data.txt")
extrap_original_data = Array{Float64}(loaded_data)[1:Int(floor(extrapolation_tspan[2] * 150)), :]
original_data = extrap_original_data[751:750 + num_of_samples, :]

data_min = Float64.(minimum(original_data, dims=1))
data_max = Float64.(maximum(original_data, dims=1))
target_matrix = Float64.(original_data') 
u0_training = Float64.(original_data[1, :]) 

nn = Lux.Chain(
    Lux.Dense(9, 32, tanh),   # 7 states + t + E = 9 inputs
    Lux.Dense(32, 32, tanh),
    Lux.Dense(32, 7)          # one correction per state
)

# Initialize parameters + state
rng = StableRNG(42)
p_nn, st = Lux.setup(rng, nn)

# IMPORTANT: wrap parameters for Optimization.jl
p_nn = ComponentArray(p_nn)
p_physics = [0.3, 0.45, 0.006, 0.033, 1.11, 1.13, 11.0, 1.5, 0.03] # Fixed physics params

# --- 2. The "Smooth" Physics (No hard IF statements) ---
function smooth_valve(deltaP, R)
    # This sigmoid replaces the "if deltaP > 0" logic
    # It provides a gradient for the NN to learn from.
    return (deltaP / R) * (1 / (1 + exp(-10.0 * deltaP)))
end

function ude_dynamics!(du, u, p, t, p_physics, nn, st, data_min, data_max)
    T = eltype(u)
    pLV, psa, psv, Vlv, Qav, Qmv, Qs = u
    τₑₛ, τₑₚ, Rmv, Zao, Rs, Csa, Csv, Eₘₐₓ, Eₘᵢₙ = p_physics

    # 1. Safety Floor for Elastance (Prevents Infinity)
    E_raw = ShiElastance(t, Eₘᵢₙ, Eₘₐₓ, 1.0, τₑₛ, τₑₚ, 0.0)
    E = max(E_raw, T(1e-4)) 
    dE = DShiElastance(t, Eₘᵢₙ, Eₘₐₓ, 1.0, τₑₛ, τₑₚ, 0.0)

    # 2. Smooth Valve Calculation
    Qav_s = smooth_valve(pLV - psa, Zao)
    Qmv_s = smooth_valve(psv - pLV, Rmv)

    # 3. Core Physics
    du[1] = (Qmv_s - Qav_s) * E + (pLV / E) * dE
    du[2] = (Qav_s - Qs) / Csa
    du[3] = (Qs - Qmv_s) / Csv
    du[4] = Qmv_s - Qav_s
    du[5] = Qav_s 
    du[6] = Qmv_s
    du[7] = (psa - psv) / Rs

    # 4. NN Correction (Learning the error)
    u_norm = (u .- T.(data_min')) ./ (T.(data_max' .- data_min') .+ T(1e-6))
    nn_input = vcat(vec(u_norm), t, E)
    nn_correction, _ = nn(nn_input, p, st)
    
    # We apply corrections to Pressure and Volume
    du[1] += T(1e-3) * nn_correction[1]
    du[4] += T(1e-3) * nn_correction[4]
end

# --- 3. Robust Loss Function ---
function loss_function(p)
    _prob = ODEProblem(
        (du, u, p, t) -> ude_dynamics!(
            du, u, p, t,
            p_physics,
            nn,
            st,
            data_min,
            data_max
        ),

        eltype(p).(u0_training),
        (9.0, 10.0),
        p
    )

    sol = solve(
        _prob,
        TRBDF2(),
        saveat = tsteps,
        abstol = 1e-6,
        reltol = 1e-6,
        maxiters = 10^6
    )

    if sol.retcode != ReturnCode.Success
        return 1e12
    end

    return mean(abs2, Array(sol) .- target_matrix)
end

# --- 4. Optimization ---
loss_history = Float64[]
callback = function (p, l)
    push!(loss_history, l)
    if length(loss_history) % 10 == 0
        println("Iteration $(length(loss_history)) | Loss: $l")
    end
    return false
end

optf = Optimization.OptimizationFunction((p, _) -> loss_function(p), Optimization.AutoZygote())
optprob = Optimization.OptimizationProblem(optf, p_nn)

# Start Adam slow
res1 = Optimization.solve(optprob, OptimizationOptimisers.Adam(1e-4), callback = callback, maxiters = 100)